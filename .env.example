# Toggle local data source:
# true = use mock client only, no backend/session required
# false = use the backend endpoints below
VITE_USE_MOCK_DATA=false

VITE_BASE_URL=http://localhost:9004
VITE_SOCKET_ORIGIN=http://localhost:9004
VITE_ORIGINAL_GAMES_SOCKET_NAMESPACE=/original-games

VITE_MEGABLOCK_GAME_KEY=mega-block
VITE_A1_STUB_SESSION_ID=a1-mock-megablock-sc

VITE_ORIGINAL_GAMES_LAUNCH_ENDPOINT=/api/v1/original-games/launch
VITE_MEGABLOCK_SETTINGS_ENDPOINT=/api/v1/original-games/mega-block/settings
VITE_MEGABLOCK_UNFINISHED_BET_ENDPOINT=/api/v1/original-games/mega-block/unfinished-bet
VITE_MEGABLOCK_PLACE_BET_ENDPOINT=/api/v1/original-games/mega-block/place-bet
VITE_MEGABLOCK_DROP_BLOCK_ENDPOINT=/api/v1/original-games/mega-block/drop-block
VITE_MEGABLOCK_CASH_OUT_ENDPOINT=/api/v1/original-games/mega-block/cash-out
VITE_MEGABLOCK_BETS_ENDPOINT=/api/v1/original-games/mega-block/bets
VITE_MEGABLOCK_BET_BY_ID_ENDPOINT=/api/v1/original-games/mega-block/bets/:betId

VITE_PROVABLY_FAIR_STATE_ENDPOINT=/api/v1/original-games/provably-fair/state
VITE_PROVABLY_FAIR_ROTATE_SEED_ENDPOINT=/api/v1/original-games/provably-fair/rotate-seed
VITE_PROVABLY_FAIR_VERIFY_ENDPOINT=/api/v1/original-games/provably-fair/verify
