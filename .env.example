# Client-safe configuration. Copy to .env.local for machine-specific values.
# Vite embeds every VITE_* value in the browser bundle: never put secrets here.

# API origin. Use / with BACKEND_PROXY_URL during local development, or an
# absolute URL when this frontend must call an API directly. Endpoint paths
# already include /api/v1.
VITE_API_BASE_URL=/

# Socket.IO server origin. This may differ from the REST API origin.
VITE_APP_SOCKET_URL=http://localhost:9004
VITE_ORIGINAL_GAMES_SOCKET_NAMESPACE=/original-games

# Game configuration
VITE_MEGABLOCK_GAME_KEY=mega-block
VITE_USE_MOCK_DATA=false

# Development-server only. This is read by Vite, not exposed to the browser.
BACKEND_PROXY_URL=http://localhost:9004
